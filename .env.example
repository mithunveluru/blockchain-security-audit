# Copy to .env and fill in values before running in production.
# For development, most defaults are acceptable.

# Flask secret key — REQUIRED in production (must be long random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Network interface for packet capture (run `ip link show` to list interfaces)
NETWORK_INTERFACE=wlp0s20f3

# Set to 1 to run WITHOUT real packet capture (no Scapy, no root required)
# ENABLE_SIMULATION_MODE=1

# Restrict WebSocket/CORS origins in production
# CORS_ORIGINS=http://localhost:5000

# Flask settings
# HOST=0.0.0.0
# PORT=5000
# FLASK_DEBUG=0
# FLASK_ENV=production

# Blockchain storage file path
# CHAIN_FILE=network_blockchain.json

# Integrity check interval in seconds
# INTEGRITY_CHECK_INTERVAL=30

# ML anomaly detector training window
# ML_LEARNING_WINDOW_DAYS=7
