# copy to .env and export it, or pass the variables to your process manager. never commit .env

# development | production | test
BLOCKAUDIT_ENV=development

# api and websocket tokens. generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# production requires the admin token. in development with none set a one-time admin token is printed at startup
BLOCKAUDIT_ADMIN_TOKEN=
BLOCKAUDIT_ANALYST_TOKEN=
BLOCKAUDIT_VIEWER_TOKEN=

# bind address. default 127.0.0.1. behind a reverse proxy use 127.0.0.1, in a container use 0.0.0.0
HOST=127.0.0.1
PORT=5000

# comma separated trusted browser origins for cross-origin api and socket access. empty means same origin only
CORS_ORIGINS=

# traffic source
ENABLE_SIMULATION_MODE=0
NETWORK_INTERFACE=

# persistence. keep the checkpoint on a different disk or host than the ledger when you can
DATA_DIR=data
CHAIN_FILE=data/network_blockchain.json
CHECKPOINT_FILE=
INTEGRITY_CHECK_INTERVAL=30

# optional copilot model. without a key the copilot answers from deterministic tools only
COPILOT_PROVIDER=auto
COPILOT_MODEL=claude-sonnet-5-5
COPILOT_TIMEOUT_SECONDS=20
ANTHROPIC_API_KEY=

# detection thresholds, defaults shown
# PORTSCAN_PORTS=20
# DOS_PPS=200
# DOS_MIN_SOURCES=20
# BRUTE_ATTEMPTS=10
# EXFIL_BYTES=10485760
# ALERT_DEDUP_SECONDS=30
# ML_MIN_TRAIN_SAMPLES=200
# ML_THRESHOLD=0.65
